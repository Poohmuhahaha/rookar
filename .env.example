PORT=8787
DATABASE_URL=./data/rookar-dev.sqlite
APP_URL=http://localhost:8090

# AI provider: mock (rule-based fallback) or openai (OpenAI-compatible API)
AI_PROVIDER=mock
ALLOW_DEV_RESET=0
# OpenCode Go -> DeepSeek V4.1 Flash (key from https://opencode.ai/console)
# AI_PROVIDER=openai
# OPENAI_API_KEY=oc_sk_...
# OPENAI_MODEL=deepseek-v4.1-flash
# OPENAI_BASE_URL=https://opencode.ai/inference/go/v1
# OPENAI_USER_AGENT=rookar-agent/1.0

# Password reset email (optional). Set ALLOW_DEV_RESET=1 only on a local machine
# to log reset links and return them to the UI for testing.
# RESEND_API_KEY=
# MAIL_FROM=ROOKAR <no-reply@rookar.co>
