FROM caddy:2-alpine
COPY dist /usr/share/caddy
COPY Caddyfile /etc/caddy/Caddyfile
RUN addgroup -S caddy && adduser -S -G caddy caddy && chown -R caddy:caddy /usr/share/caddy /etc/caddy /data /config

USER caddy

EXPOSE 8080
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
