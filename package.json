{
  "name": "rookar-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && bun test server",
    "test:e2e": "playwright test",
    "deploy": "bun run build && bunx wrangler deploy",
    "dev:web": "vite",
    "dev:api": "bun --watch server/index.ts",
    "test:server": "bun test server",
    "db:reset": "bun run server/reset.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "docker:up": "bun run build && docker compose up -d --build",
    "deploy:dry": "bun run build && bunx wrangler deploy --dry-run",
    "dev:worker": "bun run build && bunx wrangler dev",
    "db:migrate:local": "bunx wrangler d1 migrations apply rookar_db --local",
    "db:migrate:remote": "bunx wrangler d1 migrations apply rookar_db --remote"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@tanstack/vue-form": "^1.33.5",
    "@tanstack/vue-query": "^5.104.5",
    "@tanstack/vue-router": "^1.170.42",
    "@tanstack/vue-table": "^9.3.1",
    "@vueuse/core": "^15.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "hash-wasm": "^4.13.0",
    "hono": "^4.13.16",
    "motion-v": "^2.8.0",
    "msw": "^3.0.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.168.0"
  },
  "packageManager": "bun@1.4.3"
}
